# PRISM Environment Variables
# Copy this file to .env and fill in your values.
# Prefer `prism key set --provider <name> --key <key>` over editing this file.

# --- LLM Provider ---
# Which AI provider to use. Any of:
#   gemini (free tier available), claude, openai,
#   openrouter (free models), groq (free tier), together, deepseek, mistral
MODEL_PROVIDER=gemini

# --- Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Claude (paid: https://console.anthropic.com/) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- OpenAI (paid: https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenRouter (free models: https://openrouter.ai/keys) ---
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Groq (free tier: https://console.groq.com/keys) ---
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Together (paid: https://api.together.xyz/settings/api-keys) ---
# TOGETHER_API_KEY=your-together-api-key-here
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- DeepSeek (paid: https://platform.deepseek.com/api_keys) ---
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODEL=deepseek-chat

# --- Mistral (free tier: https://console.mistral.ai/) ---
# MISTRAL_API_KEY=your-mistral-api-key-here
# MISTRAL_MODEL=mistral-large-latest

# --- Timeout Override ---
# Override the tier-adjusted API timeout (in seconds).
# Default: 120s (small files), 180s (medium), 240s (large), 360s (10k+ lines)
# PRISM_TIMEOUT=180

# --- Cost Controls ---
# Max characters of file content sent to the model in one call (default 16000)
# PRISM_MAX_CONTENT_CHARS=16000